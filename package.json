{
  "name": "relaycraft",
  "private": true,
  "version": "1.5.0",
  "description": "AI-Native Web Traffic Debugging Tool",
  "homepage": "https://relaycraft.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/relaycraft/relaycraft"
  },
  "bugs": {
    "url": "https://github.com/relaycraft/relaycraft/issues"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "author": "RelayCraft Team",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "RELAYCRAFT_DEV=1 pnpm tauri dev --config '{\"productName\": \"RelayCraft Dev\", \"identifier\": \"com.relaycraft.app.dev\", \"proxy_port\": 9091}'",
    "build": "pnpm gen:licenses && tsc && vite build",
    "check:i18n": "node scripts/check-i18n.js",
    "validate:plugin": "node scripts/validate-plugin-manifest.mjs",
    "preview": "vite preview",
    "tauri": "python engine-core/build.py --sync && tauri",
    "test": "vitest",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check --apply src",
    "gen:licenses": "node scripts/generate-licenses.cjs",
    "release": "release-it",
    "translate-release:local": "node .github/scripts/translate_release.mjs",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
    "commitlint:edit": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "consola": "^3.4.2",
    "framer-motion": "^13.1.1",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "js-yaml": "^5.4.1",
    "lucide-react": "^1.37.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "release-it": "^21.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
